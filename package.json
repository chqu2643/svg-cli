{
  "name": "svg-cli",
  "version": "0.1.0",
  "description": "A command-line SVG editor built with TypeScript.",
  "private": true,
  "type": "module",
  "bin": {
    "svg-editor": "dist/main/Main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/main/Main.ts",
    "lint": "eslint .",
    "start": "node dist/main/Main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.13.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.4"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}
